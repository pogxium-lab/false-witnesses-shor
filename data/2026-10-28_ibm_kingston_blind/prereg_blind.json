 "rules_from_N_and_a_only": {
  "genome": "replace(BASE_GENOME, m0=1)",
  "table_bits": "L(a) = min(generator_core.lookup_bits(N, a, 2), 2) (unreduced powers a^(2^L - 1) < N)",
  "exponent_bits": "t(a) = L(a) + 1 (exactly one controlled multiplication, by c = a^(2^L) mod N); t = 3 is NOT one multiplication for every candidate (L(a) = 1 for every a != 2), hence the rule",
  "physical_line": "hardware.HW.place on the true circuit, calibration snapshot below",
  "dynamical_decoupling": "X-X echoes, run_ibm_arith_dd.add_dd (IBM dynamic-circuit scheduler, ALAP, min window 1 us), on every circuit",
  "wrong_constant": "smallest unit of Z_21* outside <a> (fallback: smallest unit not in {1, c})",
  "shot_plan": "largest plan with estimated QPU time <= 0.98 x 70 s (run_ibm.qpu_time: 2 s per circuit + shots x (250 us + duration + 5 us)); true circuit sqrt(k) x the shots of each witness, k = number of discriminating witnesses; rounded down to 100"
 },
 "witnesses": {
  "classical_exponent": "every exponent bit measured in Z right after its preparation",
  "decohered_control": "control bit e_L of the multiplication measured in Z right after its preparation",
  "mult_by_1": "multiplier c replaced by 1",
  "wrong_constant": "multiplier c' (rule above)"
 },
 "statistic": "V = maximum-likelihood visibility of the template P_ideal (exact noiseless distribution of the exponent register of the TRUE circuit, dynamic_sim.register_probabilities on the submitted circuit) in the model P_y = V P_ideal_y + (1 - V) / 2^t, fitted on the counts of EACH circuit with the same template; V unconstrained except P_y > 0; Newton iterations on the concave log-likelihood",
 "standard_error": "se(V) = [sum_y n_y d_y^2 / P_y(V_hat)^2]^(-1/2), d = P_ideal - U (observed Fisher information); difference of two independent circuits: sqrt(se1^2 + se2^2)",
 "discrimination": "witness w is discriminating iff v_w = <P_w - U, d> / <d, d> <= 0.5, P_w = exact noiseless pattern of the witness circuit (computed from the circuits, not from the order); non-discriminating witnesses are run and reported as such and do not enter the verdict",
 "verdict_rule": "SIGNAL iff V_true > 0 AND (V_true - V_w) / sqrt(se_true^2 + se_w^2) >= 3 for EVERY discriminating witness w (at least one required); otherwise NO SIGNAL",
 "reported": [
  "every draw (block heights, hashes, k, a), including NOT TESTABLE bases and redraws",
  "V +- se of every circuit, z against every witness (discriminating or not)",
  "V_true / se_true (significance against 0)",
  "raw counts of every register"
 ],
 "what_each_case_can_test": {
  "order 6, t = 3 (a = 2)": "table of the 4 unreduced powers 1, 2, 4, 8 driven by e0, e1; e2 controls one coset-encoded multiplication by 16 (an element of order 3): coherence of e2 with e0, e1 through a non-trivial modular multiplication (same logical true circuit as the 27 Oct runs; new witnesses, new statistic, line from today's calibration)",
  "order 3, t = 2 (a = 4, 16)": "table {1, a} driven by e0; e1 controls one multiplication by a^2 (16 resp. 4, order 3): coherence between e = 0 and e = 3 requires a^3 = 1 to be realised by the multiplication (non-trivial modular arithmetic)",
  "order 2, t = 2 (a = 8, 13)": "a^2 = 1: the multiplication is by c = 1 (identity on residues, full gate structure kept); the pattern comes from the coherence of e1 surviving the multiplication circuit; mult_by_1 is then the same circuit and is non-discriminating: tests coherence through the multiplication, not modular arithmetic beyond the identity",
  "order 6, t = 2 (a = 5, 10, 11, 17, 19)": "the four values a^0..a^3 are distinct, the exponent register is fully entangled with the work register and the ideal pattern is uniform: nothing can be tested; NOT TESTABLE -> redraw with the next block (rule fixed in advance)"
 },
